# 本地使用 development；部署时改为 production 并启用 HTTPS。
PORT=3000
NODE_ENV=development
# 部署前替换为至少 32 字符的随机值。
SESSION_SECRET=replace-with-a-long-random-secret
# 仅在首次创建 data/db.json 时读取；后续在后台修改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
# 支持 netease / qishui，也可在后台切换。
MUSIC_PROVIDER=netease
# 留空使用内置直连；仅在自建兼容音乐 API 时填写完整地址。
MUSIC_API_BASE_URL=
